    "express": "^4.18.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.19",
    "@types/jest": "^29.5.3",
    "@types/node": "^20.14.0",
    "@types/supertest": "^2.0.12",
    "jest": "^29.7.0",
    "prisma": "^5.13.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.0"
  }
